# Copy to .env or set these as environment variables. Never commit real keys.

# API keys for the web page and API: token:user_id:role, comma-separated.
# role is employee or reviewer. Tokens must be at least 12 characters.
# If this is not set, random demo tokens are printed when the server starts.
SYNAPSEHR_TOKENS=change-me-employee-1:E101:employee,change-me-reviewer-1:HR1:reviewer

# Where paused workflows and the audit log are stored (default: synapsehr.db)
SYNAPSEHR_DB=synapsehr.db

# Optional: Gemini free tier for the LLM reader and policy answers
# GEMINI_API_KEY=
# GEMINI_MODEL=
